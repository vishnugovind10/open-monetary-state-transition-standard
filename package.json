{
  "name": "omst-explorer",
  "version": "0.6.0",
  "private": true,
  "description": "OMST Explorer web interface for synthetic monetary state and transition analysis.",
  "type": "module",
  "scripts": {
    "web:dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "web:test": "playwright test -c web/playwright.config.ts",
    "ts:check": "tsc -p implementations/typescript/tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.2"
  }
}
